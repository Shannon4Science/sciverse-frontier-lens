# Optional startup defaults for scripted, headless, development, or managed use.
# Normal local users can configure both connections from the web settings page
# without creating a .env file.
SCIVERSE_API_BASE_URL=https://api.sciverse.space
SCIVERSE_API_TOKEN=
LOCAL_CONFIG_PATH=./local.config.json
ALLOW_LOCAL_SCIVERSE_CONFIG=true
REQUEST_TIMEOUT_SECONDS=20
CACHE_TTL_SECONDS=300
MAX_REQUEST_BODY_BYTES=262144

# Optional defaults for the local model settings page. Saved settings are
# written to LOCAL_CONFIG_PATH and must never be committed.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
ALLOW_LOCAL_MODEL_CONFIG=true
